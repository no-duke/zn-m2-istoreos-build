# ============================================================================
# 兆能 M2 (ZN M2) —— iStoreOS 24.10 精简版配置
# 源码：istoreos/istoreos @ istoreos-24.10  （内核 6.6）
# ----------------------------------------------------------------------------
# 设计原则：
#   1. 精简 —— 128MB NAND 的 overlay 只有 32MB，固件每瘦 1MB，可写空间就多 1MB
#   2. 预装刚需 —— coremark(跑分) / cpufreq(频率) / zerotier / nlbwmon(流量)
#   3. 代理留给用户装 —— OpenClash 含内核要 15-35MB，商店可装，不占固件
#   4. 去 WiFi —— 用户不用，且 ath11k 固件体积大
# ============================================================================

# ---------------- 目标平台 ----------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y

# 多机型模式（与 iStoreOS 的 02_network 判断逻辑一致），只选 zn_m2
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# 不产 initramfs（省体积）
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# ---------------- 去 WiFi ----------------
# 用户明确不需要 WiFi。ath11k 固件体积可观，去掉直接省几十 MB。
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_hostapd-common=n
# 注意：zn_m2 的 DEVICE_PACKAGES 里含 ipq-wifi-zn_m2（BDF 数据，仅几十 KB），
#       该包由 Makefile 强制带入，无法通过 .config 排除，留着无害。

# ============================================================================
# 一、用户明确要求保留的功能组件
# ============================================================================

# --- CPU 跑分 ---
CONFIG_PACKAGE_coremark=y

# --- CPU 频率 / 状态显示 ---
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# --- 温度显示 ---
# 由内核 tsens 驱动提供（7 个 thermal zone），跟随 target 自动编译，无需额外选包

# --- ZeroTier 内网穿透 ---
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# --- 流量监控 ---
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# ============================================================================
# 二、代理方案（省空间路线）
# ----------------------------------------------------------------------------
# HomeProxy 基于 sing-box，sing-box 本体随包编译，**不需要额外下载内核**，
# 因此不占 overlay。用户的 v2board 订阅按 sing-box UA 请求即得 JSON 配置。
# OpenClash 故意不预装 —— 它需要单独下载 15-35MB 的 mihomo 内核，
# 这部分空间留给用户按需从 iStoreOS 商店安装。
# ============================================================================
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_sing-box=y

# 若后续确定要预装 OpenClash，取消下面两行注释即可
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_openclash=y

# ============================================================================
# 三、网络基础（PNPPoE 拨号 + 硬件加速）
# ============================================================================
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-filter=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-ipt-raw=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_firewall4=y

# ============================================================================
# 四、存储 / USB（已硬改 USB 3.0，为 extroot 预留）
# ============================================================================
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_nand-utils=y

# ============================================================================
# 五、常用工具
# ============================================================================
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y

# ============================================================================
# 六、界面
# ============================================================================
CONFIG_LUCI_LANG_zh_Hans=y

# ============================================================================
# 七、精简：明确剔除的大体积包
# ----------------------------------------------------------------------------
# 这些是现固件（iStoreOS Yipush PCDN 定制版）里占空间的大头，
# 用户确认 PCDN 相关一律不要。
# ============================================================================
# --- PCDN / 挖矿类 ---
# CONFIG_PACKAGE_luci-app-pcdn is not set
# CONFIG_PACKAGE_luci-app-maicfd is not set
# --- Docker 全家桶 ---
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-docker is not set
# --- 大体积下载/媒体 ---
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-app-aria2 is not set
# CONFIG_PACKAGE_luci-app-minidlna is not set
# CONFIG_PACKAGE_luci-app-msd_lite is not set
# --- 重型 Python / Node 应用 ---
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_luci-app-alist is not set
# CONFIG_PACKAGE_luci-app-kodexplorer is not set
# CONFIG_PACKAGE_luci-app-filebrowser is not set
# --- 其他用不到的 ---
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-serverchan is not set
# CONFIG_PACKAGE_luci-app-netdata is not set

# ============================================================================
# 八、编译选项
# ============================================================================
CONFIG_CCACHE=y
CONFIG_STRIP_KERNEL_EXPORTS=y
CONFIG_USE_MKLIBS=y
